{
  "expo": {
    "name": "Pechkas",
    "slug": "pechkas-app",
    "owner": "fixmindss-team",
    "scheme": "pechkas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf6ef",
    "ios": {
      "bundleIdentifier": "net.pechkas.app",
      "supportsTablet": false
    },
    "android": {
      "package": "net.pechkas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0b5148"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#0b5148"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pechkas uses your photos so you can show a technician what is broken.",
          "cameraPermission": "Pechkas uses the camera so you can show a technician what is broken.",
          "microphonePermission": "Pechkas records sound with your video so a technician can hear the fault."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Pechkas records your voice note so you can say what is broken, in Urdu or English.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pechkas adds your exact location to a job so the technician finds your house.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0b5148",
          "defaultChannel": "jobs"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "225cda33-cb96-4105-8927-ca3f8b9d314a"
      }
    }
  }
}
